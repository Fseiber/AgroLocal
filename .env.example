# Public client configuration. Copy this template to .env and fill in values locally.
# Keep the same backend/key in the client and server pair below.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Project identifiers are public; retained for compatibility with Lovable.
VITE_SUPABASE_PROJECT_ID=

# Server configuration. The publishable key below is also PUBLIC, not an admin key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# OPTIONAL SERVER SECRETS. Do not prefix these with VITE_.
# The current marketplace does not import the service-role client from its screens.
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_DB_MIGRATION_URL=
# LOVABLE_CRON_SECRET=
# LOVABLE_CRON_SECRET_PREVIOUS=

# OPTIONAL E2E configuration: only after confirming a dedicated disposable backend.
# These scripts create/delete users, companies and files, and grant temporary roles.
# Never reuse the linked Lovable backend or production credentials here.
# E2E_SUPABASE_URL=
# E2E_SUPABASE_PUBLISHABLE_KEY=
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_ISOLATED_DATABASE=true
# E2E_CONFIRMED_URL=
# Optional existing phase-3 browser fixture mode; exports live TEST sessions locally.
# PHASE3_BROWSER_FIXTURE=0
